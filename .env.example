# Required only for answer generation. Set a model available to your API account.
# A nonempty DEEPSEEK_API_KEY selects DeepSeek; otherwise OpenAI is used.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_TOKENS=1024

OPENAI_API_KEY=
OPENAI_MODEL=

# Review-only limits; /help keeps its existing token settings.
REVIEW_DIFF_BYTES=65536
REVIEW_TOTAL_DIFF_BYTES=1048576
REVIEW_FILES_PER_REQUEST=3
REVIEW_RAG_CHUNKS=8
REVIEW_CONTEXT_BYTES=49152
REVIEW_OUTPUT_TOKENS=4096
REVIEW_REQUESTS=40
